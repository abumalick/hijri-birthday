{
	"$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!.worktrees"]
	},
	"formatter": {
		"includes": [
			"**",
			"!src/routeTree.gen.ts",
			"!node_modules/**",
			"!dist/**",
			"!.tanstack/**",
			"!playwright-report/**"
		],
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"includes": [
			"**",
			"!src/routeTree.gen.ts",
			"!node_modules/**",
			"!dist/**",
			"!.tanstack/**",
			"!playwright-report/**"
		],
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": {
				"noUnusedFunctionParameters": "off",
				"useUniqueElementIds": "off"
			},
			"complexity": {
				"noStaticOnlyClass": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"formatter": { "enabled": false },
		"linter": { "enabled": false }
	},
	"assist": {
		"includes": [
			"**",
			"!src/routeTree.gen.ts",
			"!node_modules/**",
			"!dist/**",
			"!.tanstack/**",
			"!playwright-report/**"
		],
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
